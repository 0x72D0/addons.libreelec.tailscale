<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.tailscale" name="Tailscale" version="0.1.3" provider-name="LibreELEC Tailscale Add-on">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="service.system.docker" />
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Run Tailscale using its official Docker image</summary>
    <description lang="en_GB">Manages a persistent Tailscale Docker container on LibreELEC.</description>
    <platform>all</platform>
    <license>BSD-3-Clause</license>
    <source>https://github.com/tailscale/tailscale</source>
  </extension>
</addon>